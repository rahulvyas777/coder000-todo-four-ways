@page "/lists/{ListId:int}"
@page "/lists/{ListId:int}/tasks/{TaskId:int}"
@using Microsoft.AspNetCore.Components.Sections
@implements IAsyncDisposable
@inject ApiClient Api
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(List?.Name ?? "Tasks") · Tasks</PageTitle>

<div class="main-head">
    <h2>@(List?.Name ?? (State.ListsLoaded ? "List not found" : ""))</h2>
    @if (_tasks is not null)
    {
        <span class="task-count" data-testid="task-count">@OpenCount of @_tasks.Count open</span>
    }
</div>

@if (_tasks is not null)
{
    <div class="task-add">
        <input type="text" @bind="_newTitle" @bind:event="oninput" maxlength="200"
               placeholder="Add a task" aria-label="New task title" data-testid="task-add-input"
               @onkeydown="OnAddKey" />
    </div>
}
@if (_actionError is not null)
{
    <p class="empty-state" role="alert">@_actionError</p>
}

<div class="rows-container" data-testid="rows-container" role="list" aria-label="Tasks">
    @if (_error is not null)
    {
        <p class="empty-state" role="alert">@_error</p>
    }
    else if (_tasks is null)
    {
        <p class="empty-state">Loading…</p>
    }
    else if (_tasks.Count == 0)
    {
        <p class="empty-state">Nothing here</p>
    }
    else
    {
        @foreach (var task in _tasks)
        {
            <div class="@RowClass(task)" role="listitem"
                 data-testid="task-row-@task.Id" @key="task.Id" @onclick="() => OpenTask(task)">
                <input type="checkbox" class="task-check" data-testid="task-check-@task.Id"
                       checked="@task.Completed" aria-label="@($"Completed: {task.Title}")"
                       @onchange="() => ToggleTask(task)" @onclick:stopPropagation="true" />
                @if (_editingId == task.Id)
                {
                    <span class="task-title" data-testid="task-title-@task.Id" @onclick:stopPropagation="true">
                        <input type="text" @ref="_editInput" @bind="_editText" @bind:event="oninput" maxlength="200"
                               aria-label="@($"Edit title of {task.Title}")"
                               @onkeydown="e => OnEditKey(e, task)" @onblur="() => CommitEdit(task)" />
                    </span>
                }
                else
                {
                    <span class="task-title" data-testid="task-title-@task.Id"
                          @ondblclick="() => StartEdit(task)">@task.Title</span>
                }
                <span class="task-meta">
                    @foreach (var tag in task.Tags)
                    {
                        <span class="tag" data-testid="task-tag-@task.Id-@tag">@tag</span>
                    }
                    @if (task.Priority > 0)
                    {
                        <span class="prio prio-@task.Priority" data-testid="task-priority-@task.Id"
                              role="img" aria-label="@($"{PriorityNames[task.Priority]} priority")"
                              title="@($"{PriorityNames[task.Priority]} priority")"></span>
                    }
                    @if (task.DueDate is not null)
                    {
                        <time class="task-due" data-testid="task-due-@task.Id" datetime="@task.DueDate">@FormatDue(task.DueDate)</time>
                    }
                </span>
                <button type="button" class="btn-icon btn-danger task-delete" data-testid="task-delete-@task.Id"
                        aria-label="@($"Delete {task.Title}")" @onclick="() => DeleteTask(task)"
                        @onclick:stopPropagation="true">
                    <svg class="icon" aria-hidden="true"><use href="icons.svg#i-trash" /></svg>
                </button>
            </div>
        }
    }
</div>

@if (PanelTask is { } pt)
{
    <SectionContent SectionName="task-panel">
        <aside class="panel" data-testid="task-panel" aria-label="Task details">
            <div class="panel-head">
                <input type="text" data-testid="panel-title" aria-label="Title" maxlength="200"
                       @bind="_pTitle" @bind:after="() => SaveTitle(pt)" />
                <button type="button" class="btn-icon" data-testid="panel-close" aria-label="Close details"
                        @onclick="ClosePanel">
                    <svg class="icon" aria-hidden="true"><use href="icons.svg#i-close" /></svg>
                </button>
            </div>

            <label for="panel-notes">Notes</label>
            @* change fires when the textarea loses focus, so notes save on blur *@
            <textarea id="panel-notes" data-testid="panel-notes"
                      @bind="_pNotes" @bind:after="() => SaveNotes(pt)"></textarea>

            <label for="panel-due">Due date</label>
            <input id="panel-due" type="date" data-testid="panel-due" value="@pt.DueDate"
                   @onchange="e => SaveDue(pt, e.Value as string)" />

            <label for="panel-priority">Priority</label>
            <select id="panel-priority" data-testid="panel-priority" value="@pt.Priority"
                    @onchange="e => SavePriority(pt, e.Value as string)">
                @for (var p = 0; p < PriorityNames.Length; p++)
                {
                    <option value="@p">@PriorityNames[p]</option>
                }
            </select>

            <label for="panel-tags-input">Tags</label>
            <div class="tags-box">
                @foreach (var tag in pt.Tags)
                {
                    <span class="tag" data-testid="panel-tag-@tag">
                        @tag
                        <button type="button" aria-label="@($"Remove tag {tag}")" @onclick="() => RemoveTag(pt, tag)">
                            <svg class="icon" aria-hidden="true"><use href="icons.svg#i-close" /></svg>
                        </button>
                    </span>
                }
                <input id="panel-tags-input" type="text" data-testid="panel-tags-input" placeholder="Add a tag"
                       @bind="_pTag" @bind:event="oninput" @onkeydown="e => OnTagKey(e, pt)" />
            </div>

            <label for="panel-repeat">Repeat</label>
            <select id="panel-repeat" data-testid="panel-repeat" value="@pt.Repeat"
                    @onchange="e => SaveRepeat(pt, e.Value as string)">
                <option value="none">Never</option>
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly">Monthly</option>
            </select>
        </aside>
    </SectionContent>
}

@code {
    [Parameter] public int ListId { get; set; }
    [Parameter] public int? TaskId { get; set; }

    private List<TaskItem>? _tasks;
    private string? _error;
    private int _loadedListId;
    private int _loadVersion;

    private TaskList? List => State.FindList(ListId);
    private int OpenCount => _tasks?.Count(t => !t.Completed) ?? 0;

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        _ = State.EnsureListsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        SyncPanel();
        if (ListId == _loadedListId) return;
        _loadedListId = ListId;
        _tasks = null;
        _error = null;
        // A slower response for a list the user already left must not overwrite the new one.
        var version = ++_loadVersion;
        try
        {
            var tasks = await Api.GetTasksAsync(ListId);
            if (version == _loadVersion)
            {
                _tasks = tasks;
                SyncPanel();
            }
        }
        catch (HttpRequestException ex)
        {
            if (version == _loadVersion)
            {
                _error = ex.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "This list does not exist."
                    : $"Could not load the tasks: {ex.Message}";
            }
        }
    }

    private string _newTitle = "";
    private int? _editingId;
    private string _editText = "";
    private ElementReference _editInput;
    private bool _focusEdit;
    private string? _actionError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            _keysModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keys.js");
            _keys = await _keysModule.InvokeAsync<IJSObjectReference>("register", _selfRef);
        }
        if (_focusEdit && _editingId is not null)
        {
            _focusEdit = false;
            await _editInput.FocusAsync();
        }
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _tasks is null) return;
        var title = _newTitle.Trim();
        if (title.Length == 0) return;
        _newTitle = "";
        var listId = ListId;
        await Run(async () =>
        {
            var created = await Api.CreateTaskAsync(listId, title);
            if (listId == ListId) _tasks?.Add(created);
        });
    }

    // Each change is applied optimistically, then replaced by the task the server returns.
    private async Task ToggleTask(TaskItem task)
    {
        var completing = !task.Completed;
        task.Completed = completing;
        await Run(async () =>
        {
            if (completing)
            {
                var result = await Api.CompleteTaskAsync(task.Id);
                Replace(result.Task);
                if (result.Next is not null && result.Next.ListId == ListId) _tasks?.Add(result.Next);
            }
            else
            {
                Replace(await Api.ReopenTaskAsync(task.Id));
            }
        });
    }

    private void StartEdit(TaskItem task)
    {
        _editingId = task.Id;
        _editText = task.Title;
        _focusEdit = true;
    }

    private async Task OnEditKey(KeyboardEventArgs e, TaskItem task)
    {
        if (e.Key == "Escape") _editingId = null;
        else if (e.Key == "Enter") await CommitEdit(task);
    }

    private async Task CommitEdit(TaskItem task)
    {
        // Enter commits, and the blur that follows when the input goes away must not commit twice.
        if (_editingId != task.Id) return;
        _editingId = null;
        var title = _editText.Trim();
        if (title.Length == 0 || title == task.Title) return;
        task.Title = title;
        await Run(async () => Replace(await Api.RenameTaskAsync(task.Id, title)));
    }

    private async Task DeleteTask(TaskItem task)
    {
        _tasks?.Remove(task);
        await Run(() => Api.DeleteTaskAsync(task.Id));
    }

    private void Replace(TaskItem updated)
    {
        if (_tasks is null) return;
        var i = _tasks.FindIndex(t => t.Id == updated.Id);
        if (i >= 0) _tasks[i] = updated;
    }

    /// <summary>Runs a change, then refreshes the sidebar counts; on failure re-reads the server state.</summary>
    private async Task Run(Func<Task> action)
    {
        try
        {
            _actionError = null;
            await action();
        }
        catch (HttpRequestException ex)
        {
            _actionError = $"The change was not saved: {ex.Message}";
            try { _tasks = await Api.GetTasksAsync(ListId); } catch (HttpRequestException) { }
        }
        await State.ReloadListsAsync();
    }

    // ---- Row details and the detail panel ----

    private static readonly string[] PriorityNames = ["None", "Low", "Medium", "High"];

    private TaskItem? PanelTask => TaskId is int id ? _tasks?.Find(t => t.Id == id) : null;
    private int? _panelTaskId;
    private string _pTitle = "";
    private string _pNotes = "";
    private string _pTag = "";

    private DotNetObjectReference<ListPage>? _selfRef;
    private IJSObjectReference? _keysModule;
    private IJSObjectReference? _keys;

    private string RowClass(TaskItem task)
    {
        var css = "task-row";
        if (task.Completed) css += " completed";
        if (IsOverdue(task)) css += " overdue";
        if (task.Id == TaskId) css += " open";
        return css;
    }

    private static bool IsOverdue(TaskItem task) =>
        !task.Completed && task.DueDate is not null
        && string.CompareOrdinal(task.DueDate, DateTime.Today.ToString("yyyy-MM-dd")) < 0;

    private static string FormatDue(string dueDate) =>
        DateOnly.TryParseExact(dueDate, "yyyy-MM-dd", out var d)
            ? d.ToString(d.Year == DateTime.Today.Year ? "MMM d" : "MMM d, yyyy")
            : dueDate;

    /// <summary>Loads the panel's editable text fields when it opens on another task.</summary>
    private void SyncPanel()
    {
        var task = PanelTask;
        if (task?.Id == _panelTaskId) return;
        _panelTaskId = task?.Id;
        _pTitle = task?.Title ?? "";
        _pNotes = task?.Notes ?? "";
        _pTag = "";
    }

    // The query (filter, search, sort in later steps) is kept when the panel opens or closes.
    private string Query => new Uri(Nav.Uri).Query;

    private void OpenTask(TaskItem task)
    {
        if (task.Id != TaskId) Nav.NavigateTo($"lists/{ListId}/tasks/{task.Id}{Query}");
    }

    private void ClosePanel() => Nav.NavigateTo($"lists/{ListId}{Query}");

    [JSInvokable]
    public void OnEscape()
    {
        if (TaskId is not null) ClosePanel();
    }

    private async Task Save(TaskItem task, object patch) =>
        await Run(async () => Replace(await Api.UpdateTaskAsync(task.Id, patch)));

    private async Task SaveTitle(TaskItem task)
    {
        var title = _pTitle.Trim();
        if (title.Length == 0) { _pTitle = task.Title; return; }
        if (title == task.Title) return;
        task.Title = title;
        await Save(task, new { title });
    }

    private async Task SaveNotes(TaskItem task)
    {
        if (_pNotes == task.Notes) return;
        task.Notes = _pNotes;
        await Save(task, new { notes = _pNotes });
    }

    private async Task SaveDue(TaskItem task, string? value)
    {
        var dueDate = string.IsNullOrEmpty(value) ? null : value;
        if (dueDate == task.DueDate) return;
        task.DueDate = dueDate;
        await Save(task, new { dueDate });
    }

    private async Task SavePriority(TaskItem task, string? value)
    {
        if (!int.TryParse(value, out var priority) || priority == task.Priority) return;
        task.Priority = priority;
        await Save(task, new { priority });
    }

    private async Task SaveRepeat(TaskItem task, string? value)
    {
        if (string.IsNullOrEmpty(value) || value == task.Repeat) return;
        task.Repeat = value;
        await Save(task, new { repeat = value });
    }

    private async Task SaveTags(TaskItem task, List<string> tags)
    {
        task.Tags = tags;
        await Save(task, new { tags });
    }

    private async Task OnTagKey(KeyboardEventArgs e, TaskItem task)
    {
        if (e.Key == "Enter")
        {
            // Tags are lower-case and unique (the contract).
            var tag = _pTag.Trim().ToLowerInvariant();
            _pTag = "";
            if (tag.Length == 0 || task.Tags.Contains(tag)) return;
            await SaveTags(task, [.. task.Tags, tag]);
        }
        else if (e.Key == "Backspace" && _pTag.Length == 0 && task.Tags.Count > 0)
        {
            await SaveTags(task, task.Tags[..^1]);
        }
    }

    private Task RemoveTag(TaskItem task, string tag) =>
        SaveTags(task, task.Tags.Where(t => t != tag).ToList());

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        try
        {
            if (_keys is not null)
            {
                await _keys.InvokeVoidAsync("dispose");
                await _keys.DisposeAsync();
            }
            if (_keysModule is not null) await _keysModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
