@page "/"
@page "/lists/{ListId:int}"
@page "/lists/{ListId:int}/tasks/{TaskId:int}"
@using BlazorServerClient.Services
@inject TasksApi Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(CurrentList is null ? "Tasks" : $"{CurrentList.Name} · Tasks")</PageTitle>

<div class="app">
    <aside class="sidebar" aria-label="Lists">
        <div class="sidebar-head">
            <h1 class="app-title" data-testid="app-title">Tasks</h1>
            <div class="sidebar-tools">
                <button type="button" class="btn-icon" data-testid="list-add" aria-label="Add list"
                        aria-expanded="@(adding ? "true" : "false")" @onclick="StartAdd">
                    <svg class="icon" aria-hidden="true"><use href="icons.svg#i-plus" /></svg>
                </button>
            </div>
        </div>
        <nav aria-label="Lists">
            <ul class="list-nav" data-testid="list-nav">
                @foreach (var l in lists)
                {
                    @* The rename editor is always rendered and shown by inline-edit.js on the click itself. *@
                    <li class="list-item @(l.Id == ListId ? "active" : null)" data-testid="list-item-@l.Id"
                        data-inline-edit-host data-editing="@(renamingId == l.Id)" @key="l.Id">
                        <input type="text" aria-label="List name" maxlength="80" data-inline-edit-input
                               @bind:get="renamingId == l.Id ? renameText : l.Name"
                               @bind:set="v => renameText = v" @bind:event="oninput"
                               @onkeydown="e => OnRenameKey(e, l)" @onblur="() => CommitRename(l)" />
                        <a href="lists/@l.Id" aria-current="@(l.Id == ListId ? "page" : null)" data-inline-edit-view>
                            <span data-inline-edit="dblclick" @ondblclick="() => StartRename(l)">@l.Name</span>
                            <span class="list-count" data-testid="list-count-@l.Id">@l.OpenCount<span class="visually-hidden"> open</span></span>
                        </a>
                        <span class="list-actions" data-inline-edit-view>
                            <button type="button" class="btn-icon" data-testid="list-rename-@l.Id" data-inline-edit="click"
                                    aria-label="Rename list @l.Name" @onclick="() => StartRename(l)">
                                <svg class="icon" aria-hidden="true"><use href="icons.svg#i-edit" /></svg>
                            </button>
                            <button type="button" class="btn-icon btn-danger" data-testid="list-delete-@l.Id"
                                    aria-label="Delete list @l.Name" @onclick="() => DeleteList(l)">
                                <svg class="icon" aria-hidden="true"><use href="icons.svg#i-trash" /></svg>
                            </button>
                        </span>
                    </li>
                }
            </ul>
        </nav>
        @if (adding)
        {
            <div class="list-add-row">
                <input type="text" data-testid="list-name-input" aria-label="New list name" maxlength="80"
                       placeholder="New list" @ref="addInput"
                       @bind="newName" @bind:event="oninput" @onkeydown="OnAddKey" />
            </div>
        }
    </aside>

    <main class="main">
        @if (notFound)
        {
            <div class="main-head"><h2>List not found</h2></div>
            <p class="empty-state">This list does not exist or was deleted.</p>
        }
        else
        {
            <div class="main-head">
                <h2>@CurrentList?.Name</h2>
                <span class="task-count" data-testid="task-count">@OpenCount of @tasks.Count open</span>
            </div>
            @* Prerendered HTML is inert until the circuit connects, so clicks there are lost; the rows
               container appears only once the page is interactive. *@
            @if (!RendererInfo.IsInteractive)
            {
                <p class="empty-state">Loading…</p>
            }
            else
            {
                <div class="task-add">
                    <input type="text" data-testid="task-add-input" aria-label="New task" maxlength="200"
                           placeholder="Add a task" @bind="newTaskTitle" @bind:event="oninput" @onkeydown="OnTaskAddKey" />
                </div>
                <div class="rows-container" data-testid="rows-container" role="list" aria-label="Tasks">
                    @foreach (var t in tasks)
                    {
                        <div class="task-row @RowClass(t)" data-testid="task-row-@t.Id" role="listitem" @key="t.Id"
                             @onclick="() => OpenTask(t)">
                            <input type="checkbox" class="task-check" data-testid="task-check-@t.Id" @onclick:stopPropagation
                                   checked="@t.Completed" @onchange="() => ToggleTask(t)" aria-label="Completed: @t.Title" />
                            @* Same inline editor as the list rename (inline-edit.js opens it on the double-click). *@
                            <span class="task-title" data-testid="task-title-@t.Id" data-inline-edit-host
                                  data-inline-edit="dblclick" data-editing="@(editingTaskId == t.Id)"
                                  @ondblclick="() => StartEditTask(t)">
                                <input type="text" aria-label="Task title" maxlength="200" data-inline-edit-input
                                       @onclick:stopPropagation @bind:get="editingTaskId == t.Id ? editTitle : t.Title"
                                       @bind:set="v => editTitle = v ?? string.Empty" @bind:event="oninput"
                                       @onkeydown="e => OnEditTaskKey(e, t)" @onblur="() => CommitEditTask(t)" />
                                <span data-inline-edit-view>@t.Title</span>
                            </span>
                            <span class="task-meta">
                                @foreach (var tag in t.Tags)
                                {
                                    <span class="tag" data-testid="task-tag-@t.Id-@tag">@tag</span>
                                }
                                @if (t.DueDate is { } due)
                                {
                                    <time class="task-due" data-testid="task-due-@t.Id" datetime="@due.ToString("yyyy-MM-dd")">@FormatDue(due)</time>
                                }
                                @if (t.Priority > 0)
                                {
                                    var name = TaskPanel.PriorityNames[Math.Clamp(t.Priority, 0, 3)];
                                    <span class="prio prio-@t.Priority" data-testid="task-priority-@t.Id" role="img"
                                          aria-label="Priority @name.ToLowerInvariant()" title="Priority @name.ToLowerInvariant()"></span>
                                }
                            </span>
                            <button type="button" class="btn-icon btn-danger task-delete" data-testid="task-delete-@t.Id" @onclick:stopPropagation
                                    aria-label="Delete task @t.Title" @onclick="() => DeleteTask(t)">
                                <svg class="icon" aria-hidden="true"><use href="icons.svg#i-trash" /></svg>
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </main>

    @if (RendererInfo.IsInteractive && OpenTaskItem is { } open)
    {
        <TaskPanel @key="open.Id" Task="open" OnSaved="ReplaceTask" OnClose="ClosePanel" />
    }
</div>

@code {
    [Parameter] public int? ListId { get; set; }
    [Parameter] public int? TaskId { get; set; }

    private List<TaskList> lists = [];
    private List<TaskItem> tasks = [];
    private int? loadedListId;
    private bool notFound;

    private TaskList? CurrentList => lists.FirstOrDefault(l => l.Id == ListId);
    private int OpenCount => tasks.Count(t => !t.Completed);

    protected override async Task OnParametersSetAsync()
    {
        lists = await Api.GetListsAsync();

        if (ListId is null)
        {
            if (lists.Count > 0) Nav.NavigateTo($"lists/{lists[0].Id}", replace: true);
            return;
        }

        if (loadedListId != ListId)
        {
            var loaded = await Api.GetTasksAsync(ListId.Value);
            notFound = loaded is null;
            tasks = loaded ?? [];
            loadedListId = ListId;
        }
    }

    // Sidebar list editing: add, inline rename, delete.
    private bool adding;
    private string newName = "";
    private ElementReference addInput;
    private int? renamingId;
    private string renameText = "";
    private bool focusAdd;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusAdd && adding)
        {
            focusAdd = false;
            await addInput.FocusAsync();
        }
    }

    private void StartAdd()
    {
        adding = true;
        newName = "";
        focusAdd = true;
    }

    private async Task OnAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            adding = false;
            return;
        }
        if (e.Key != "Enter") return;
        var name = newName.Trim();
        if (name.Length == 0) return;
        adding = false;
        newName = "";
        var created = await Api.CreateListAsync(name);
        lists = await Api.GetListsAsync();
        Nav.NavigateTo($"lists/{created.Id}");
    }

    private void StartRename(TaskList l)
    {
        renamingId = l.Id;
        renameText = l.Name;
    }

    private async Task OnRenameKey(KeyboardEventArgs e, TaskList l)
    {
        if (e.Key == "Enter") await CommitRename(l);
        else if (e.Key == "Escape") renamingId = null;
    }

    private async Task CommitRename(TaskList l)
    {
        if (renamingId != l.Id) return;
        renamingId = null;
        var name = renameText.Trim();
        if (name.Length == 0 || name == l.Name) return;
        var updated = await Api.RenameListAsync(l.Id, name);
        // The lists may have been reloaded (navigation) since this handler captured `l`.
        if (lists.FirstOrDefault(x => x.Id == updated.Id) is { } current) current.Name = updated.Name;
    }

    // Tasks: add, toggle, inline title edit, delete. Each change keeps the server's response.
    private string newTaskTitle = "";
    private int? editingTaskId;
    private string editTitle = "";

    private void ReplaceTask(TaskItem updated)
    {
        var i = tasks.FindIndex(x => x.Id == updated.Id);
        if (i >= 0) tasks[i] = updated;
    }

    private async Task OnTaskAddKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || ListId is null) return;
        var title = newTaskTitle.Trim();
        newTaskTitle = "";
        if (title.Length == 0) return;
        var listId = ListId.Value;
        var created = await Api.CreateTaskAsync(listId, title);
        if (loadedListId == listId) tasks.Add(created);
        lists = await Api.GetListsAsync();
    }

    private async Task ToggleTask(TaskItem t)
    {
        var updated = t.Completed
            ? await Api.ReopenTaskAsync(t.Id)
            : (await Api.CompleteTaskAsync(t.Id)).Task;
        ReplaceTask(updated);
        lists = await Api.GetListsAsync();
    }

    private void StartEditTask(TaskItem t)
    {
        editingTaskId = t.Id;
        editTitle = t.Title;
    }

    private async Task OnEditTaskKey(KeyboardEventArgs e, TaskItem t)
    {
        if (e.Key == "Enter") await CommitEditTask(t);
        else if (e.Key == "Escape") editingTaskId = null;
    }

    private async Task CommitEditTask(TaskItem t)
    {
        if (editingTaskId != t.Id) return;
        editingTaskId = null;
        var title = editTitle.Trim();
        if (title.Length == 0 || title == t.Title) return;
        ReplaceTask(await Api.RenameTaskAsync(t.Id, title));
    }

    private async Task DeleteTask(TaskItem t)
    {
        await Api.DeleteTaskAsync(t.Id);
        tasks.RemoveAll(x => x.Id == t.Id);
        lists = await Api.GetListsAsync();
    }

    // Detail panel: the open task is the one in the route.
    private TaskItem? OpenTaskItem => TaskId is null ? null : tasks.FirstOrDefault(t => t.Id == TaskId);

    private string Query => new Uri(Nav.Uri).Query;

    private void OpenTask(TaskItem t)
    {
        if (editingTaskId == t.Id) return;
        Nav.NavigateTo($"lists/{t.ListId}/tasks/{t.Id}{Query}");
    }

    private void ClosePanel() => Nav.NavigateTo($"lists/{ListId}{Query}");

    private string? RowClass(TaskItem t)
    {
        var c = new List<string>();
        if (t.Completed) c.Add("completed");
        if (!t.Completed && t.DueDate < DateOnly.FromDateTime(DateTime.Today)) c.Add("overdue");
        if (t.Id == TaskId) c.Add("open");
        return c.Count == 0 ? null : string.Join(' ', c);
    }

    private static string FormatDue(DateOnly due)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (due == today) return "Today";
        if (due == today.AddDays(1)) return "Tomorrow";
        return due.Year == today.Year ? due.ToString("MMM d") : due.ToString("MMM d, yyyy");
    }

    private async Task DeleteList(TaskList l)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete the list \"{l.Name}\" and its tasks?")) return;
        await Api.DeleteListAsync(l.Id);
        lists = await Api.GetListsAsync();
        if (l.Id == ListId)
        {
            loadedListId = null;
            Nav.NavigateTo(lists.Count > 0 ? $"lists/{lists[0].Id}" : "", replace: true);
        }
    }
}
