# Copy to .env.client in this folder (it is not committed). Port plan: API 160x0, dev client 160x1,
# production host 160x2; x = 1 blazor-wasm, 2 blazor-server, 3 react, 4 angular, 5 reference.
CLIENT_URL=http://localhost:16051
API_URL=http://localhost:16050
# Optional: let Playwright start the client's dev server (runs from the client root, one level up).
# CLIENT_START=npm run dev -- --port 16051 --strictPort
# Optional: where the JSON report goes (default results.json).
# E2E_JSON=results.json
